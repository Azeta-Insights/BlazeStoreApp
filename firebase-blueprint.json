{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store inventory product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "inStock": { "type": "boolean" },
        "stockQuantity": { "type": "number" },
        "description": { "type": "string" },
        "sku": { "type": "string" },
        "featured": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" }
      },
      "required": ["id", "name", "price", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "currency": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderId", "total", "status"]
    },
    "User": {
      "title": "User",
      "description": "Registered customer or store manager profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "roleType": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "name"]
    },
    "RefundRecord": {
      "title": "RefundRecord",
      "description": "Refund transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "amount": { "type": "number" },
        "reason": { "type": "string" },
        "refundedBy": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderId", "amount", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Store activity notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "time": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string" }
      },
      "required": ["id", "title", "message"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "#/entities/Product",
      "description": "Inventory products collection"
    },
    "/orders/{orderId}": {
      "schema": "#/entities/Order",
      "description": "Customer orders collection"
    },
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profiles collection"
    },
    "/refunds/{refundId}": {
      "schema": "#/entities/RefundRecord",
      "description": "Refund logs collection"
    },
    "/notifications/{notifId}": {
      "schema": "#/entities/Notification",
      "description": "Notifications collection"
    }
  }
}
